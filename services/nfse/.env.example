PORT=8080
HOST=0.0.0.0

# Mesmo valor de NFSE_SERVICE_TOKEN no app. Gere com: openssl rand -hex 32
SERVICE_TOKEN=

# Certificado A1 em base64. Gere com:
#   base64 -w0 certificado.pfx        (Linux)
#   base64 -i certificado.pfx         (macOS)
CERT_PFX_BASE64=
CERT_SENHA=

# HOMOLOGACAO enquanto estiver testando; PRODUCAO emite nota com valor fiscal.
AMBIENTE=HOMOLOGACAO

# Endpoints do Ambiente de Dados Nacional (só mude se a SEFIN alterar).
# ADN_URL_HOMOLOGACAO=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
# ADN_URL_PRODUCAO=https://sefin.nfse.gov.br/sefinnacional
