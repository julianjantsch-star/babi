# ---------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role: ignora RLS. Só no servidor, nunca exposta ao navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------
# URL pública do site — usada nos links dos e-mails de convite/recuperação.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do 2FA: assina o cookie de verificação e faz o pepper dos códigos.
# Gere com: openssl rand -base64 48
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ---------------------------------------------------------------------
# E-mail (Resend) — 3.000/mês no plano gratuito
# ---------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Consultório <financeiro@seudominio.com.br>"

# ---------------------------------------------------------------------
# Microserviço de NFS-e (services/nfse)
# Sem estas duas variáveis o app funciona normalmente, apenas sem emitir nota.
# ---------------------------------------------------------------------
NFSE_SERVICE_URL=https://odonto-nfse.fly.dev
NFSE_SERVICE_TOKEN=mesmo-valor-do-SERVICE_TOKEN-do-microservico
